{
  "enabled_when": "X_BEARER_TOKEN is set",
  "accounts": { "hormuz": [], "oil": [], "chips": [], "ai": [] },
  "queries": {
    "hormuz": "(hormuz OR \"strait of hormuz\") lang:en -is:retweet",
    "oil": "(brent OR \"crude oil\" OR opec) lang:en -is:retweet",
    "chips": "(semiconductor OR nvidia OR tsmc OR hbm) lang:en -is:retweet",
    "ai": "(\"data center\" OR hyperscaler OR stargate) lang:en -is:retweet"
