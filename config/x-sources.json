  "sample_per_desk_per_hour": 10,
  "min_followers": 1000,
  "account_weight": 1.5,
  "engagement_weight": "1 + log10(1 + likes + 2*reposts), capped at 3",
  "dedupe": "token Jaccard >= 0.8 within 6h"
}
